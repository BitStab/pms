<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Enhanced Auto Guest Registration -->
        <record id="ir_cron_auto_guest_registration_enhanced" model="ir.cron">
            <field name="name">PMS IT: Enhanced Auto Guest Registration</field>
            <field name="model_id" ref="model_pms_property"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_guest_registration()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
            <field name="priority">5</field>
        </record>
        
        <!-- Receipt Download Cron -->
        <record id="ir_cron_download_receipts" model="ir.cron">
            <field name="name">PMS IT: Download Registration Receipts</field>
            <field name="model_id" ref="model_pms_guest_registration_receipt"/>
            <field name="state">code</field>
            <field name="code">model._cron_download_receipts()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
            <field name="priority">10</field>
        </record>
        
        <!-- Remote Check-in Reminder Cron -->
        <record id="ir_cron_remote_checkin_reminders" model="ir.cron">
            <field name="name">PMS IT: Send Remote Check-in Reminders</field>
            <field name="model_id" ref="model_pms_property"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_remote_checkin_reminders()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
            <field name="priority">15</field>
        </record>
        
        <!-- Generate Remote Check-in Links -->
        <record id="ir_cron_generate_remote_checkin_links" model="ir.cron">
            <field name="name">PMS IT: Generate Remote Check-in Links</field>
            <field name="model_id" ref="model_pms_property"/>
            <field name="state">code</field>
            <field name="code">
            model._cron_generate_remote_checkin_links()
            </field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
            <field name="priority">20</field>
        </record>
        
        <!-- Enhanced Registration Alerts -->
        <record id="ir_cron_registration_alerts_enhanced" model="ir.cron">
            <field name="name">PMS IT: Enhanced Registration Alerts</field>
            <field name="model_id" ref="model_pms_guest_registration_alert"/>
            <field name="state">code</field>
            <field name="code">model.check_and_create_alerts()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
            <field name="priority">5</field>
        </record>
        
        <!-- Data Cleanup Cron -->
        <record id="ir_cron_cleanup_old_data" model="ir.cron">
            <field name="name">PMS IT: Cleanup Old Data</field>
            <field name="model_id" ref="model_pms_property"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_old_data()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
            <field name="priority">30</field>
        </record>
        
        <!-- Weekly Summary Report -->
        <record id="ir_cron_weekly_summary" model="ir.cron">
            <field name="name">PMS IT: Weekly Registration Summary</field>
            <field name="model_id" ref="model_pms_property"/>
            <field name="state">code</field>
            <field name="code">
model.cron_send_weekly_registration_summary()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
            <field name="priority">25</field>
        </record>
        
        <!-- Sync Reference Tables -->
        <record id="ir_cron_sync_reference_tables" model="ir.cron">
            <field name="name">PMS IT: Sync Reference Tables</field>
            <field name="model_id" ref="model_alloggiati_table_manager"/>
            <field name="state">code</field>
            <field name="code">
# Sync reference tables monthly for all properties
model.cron_sync_reference_tables()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
            <field name="priority">35</field>
        </record>
        
        <!-- Retry Failed Registrations -->
        <record id="ir_cron_retry_failed_registrations" model="ir.cron">
            <field name="name">PMS IT: Retry Failed Registrations</field>
            <field name="model_id" ref="model_pms_guest_registration"/>
            <field name="state">code</field>
            <field name="code">
# Retry failed registrations that are less than 24 hours old
model.cron_retry_failed_registrations()
            </field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
            <field name="priority">10</field>
        </record>
        
    </data>
</odoo>