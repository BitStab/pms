<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Guest Group Tree View -->
        <record id="pms_guest_group_view_tree" model="ir.ui.view">
            <field name="name">pms.guest.group.tree</field>
            <field name="model">pms.guest.group</field>
            <field name="arch" type="xml">
                <tree decoration-info="group_type == 'family'" 
                      decoration-success="group_type == 'group'"
                      decoration-muted="group_type == 'individual'">
                    <field name="display_name"/>
                    <field name="reservation_id"/>
                    <field name="group_type" widget="badge"/>
                    <field name="main_guest_id"/>
                    <field name="guest_count"/>
                    <field name="state" widget="badge"/>
                    <field name="property_id"/>
                </tree>
            </field>
        </record>

        <!-- Guest Group Form View -->
        <record id="pms_guest_group_view_form" model="ir.ui.view">
            <field name="name">pms.guest.group.form</field>
            <field name="model">pms.guest.group</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_auto_detect_group" 
                                string="Auto-Detect Group Type" 
                                type="object" 
                                class="btn-secondary"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_confirm_group" 
                                string="Confirm Group" 
                                type="object" 
                                class="btn-primary"
                                attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="display_name"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="reservation_id"/>
                                <field name="property_id"/>
                                <field name="group_type" widget="radio"/>
                            </group>
                            <group>
                                <field name="main_guest_id"/>
                                <field name="guest_count" readonly="1"/>
                            </group>
                        </group>
                        
                        <separator string="Group Members"/>
                        <field name="dependent_guest_ids">
                            <tree>
                                <field name="firstname"/>
                                <field name="lastname"/>
                                <field name="birthdate_date"/>
                                <field name="tipo_alloggiato_code"/>
                                <field name="is_main_guest"/>
                                <field name="it_registered"/>
                            </tree>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Guest Group Action -->
        <record id="action_pms_guest_group" model="ir.actions.act_window">
            <field name="name">Guest Groups</field>
            <field name="res_model">pms.guest.group</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first guest group!
                </p>
                <p>
                    Guest groups are automatically created based on reservations.
                    You can manage family and travel group relationships here.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_pms_guest_group"
                  name="Guest Groups"
                  parent="menu_italian_registration_main"
                  action="action_pms_guest_group"
                  sequence="46"/>

    </data>
</odoo>