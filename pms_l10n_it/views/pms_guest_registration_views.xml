<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Guest Registration Tree View -->
        <record id="pms_guest_registration_view_tree" model="ir.ui.view">
            <field name="name">pms.guest.registration.tree</field>
            <field name="model">pms.guest.registration</field>
            <field name="arch" type="xml">
                <tree decoration-success="state == 'sent'" decoration-danger="state == 'error'" decoration-muted="state == 'cancelled'">
                    <field name="display_name"/>
                    <field name="property_id"/>
                    <field name="registration_date"/>
                    <field name="guest_count"/>
                    <field name="state" widget="badge" decoration-success="state == 'sent'" decoration-danger="state == 'error'"/>
                    <field name="transmission_date"/>
                </tree>
            </field>
        </record>

        <!-- Guest Registration Form View -->
        <record id="pms_guest_registration_view_form" model="ir.ui.view">
            <field name="name">pms.guest.registration.form</field>
            <field name="model">pms.guest.registration</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_send_registration" 
                                string="Send to Alloggiati Web" 
                                type="object" 
                                class="btn-primary"
                                invisible="state in ('sent', 'cancelled')"/>
                        <button name="action_cancel" 
                                string="Cancel" 
                                type="object"
                                invisible="state in ('sent', 'cancelled')"/>
                        <button name="action_reset_to_draft" 
                                string="Reset to Draft" 
                                type="object"
                                invisible="state != 'error'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,sent"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="display_name"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="property_id" readonly="1"/>
                                <field name="registration_date"/>
                                <field name="guest_count"/>
                            </group>
                            <group>
                                <field name="transmission_date" readonly="1"/>
                                <field name="response_message" readonly="1" invisible="not response_message"/>
                                <field name="error_message" readonly="1" invisible="not error_message"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Guests to Register" name="guests">
                                <field name="checkin_partner_ids">
                                    <tree editable="bottom">
                                        <field name="firstname"/>
                                        <field name="lastname"/>
                                        <field name="birthdate_date"/>
                                        <field name="nationality_id"/>
                                        <field name="document_type"/>
                                        <field name="document_number"/>
                                        <field name="arrival"/>
                                        <field name="departure"/>
                                        <field name="it_registered" readonly="1"/>
                                    </tree>
                                </field>
                            </page>
                            
                            <page string="Generated Content" name="content" invisible="not xml_content">
                                <group>
                                    <field name="xml_content" readonly="1" widget="text"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Guest Registration Search View -->
        <record id="pms_guest_registration_view_search" model="ir.ui.view">
            <field name="name">pms.guest.registration.search</field>
            <field name="model">pms.guest.registration</field>
            <field name="arch" type="xml">
                <search>
                    <field name="display_name"/>
                    <field name="property_id"/>
                    <field name="registration_date"/>
                    <field name="state"/>
                    
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Sent" name="sent" domain="[('state', '=', 'sent')]"/>
                    <filter string="Error" name="error" domain="[('state', '=', 'error')]"/>
                    
                    <separator/>
                    <filter string="Today" name="today" domain="[('registration_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter string="This Week" name="this_week" domain="[('registration_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <filter string="This Month" name="this_month" domain="[('registration_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                    
                    <group expand="0" string="Group By">
                        <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                        <filter string="Date" name="group_date" context="{'group_by': 'registration_date'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Guest Registration Action -->
        <record id="action_pms_guest_registration" model="ir.actions.act_window">
            <field name="name">Guest Registrations</field>
            <field name="res_model">pms.guest.registration</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="pms_guest_registration_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first guest registration!
                </p>
                <p>
                    Manage Italian guest registrations (Alloggiati Web) for your properties.
                    You can register guests manually or set up automatic registration.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_pms_guest_registration"
                  name="Guest Registrations"
                  parent="menu_italian_registration_main"
                  action="action_pms_guest_registration"
                  sequence="50"/>

    </data>
</odoo>