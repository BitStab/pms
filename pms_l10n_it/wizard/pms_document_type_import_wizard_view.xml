<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- PMS Document Type Import Wizard Form -->
        <record id="pms_document_type_import_wizard_view_form" model="ir.ui.view">
            <field name="name">pms.document.type.import.wizard.form</field>
            <field name="model">pms.document.type.import.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>Import Document Types</h1>
                            <h2>OCA PMS Compatible</h2>
                        </div>
                        
                        <group invisible="context.get('show_result', False)">
                            <group>
                                <field name="csv_file" filename="csv_filename"/>
                                <field name="csv_filename" invisible="1"/>
                            </group>
                            <group>
                                <field name="update_existing"/>
                                <field name="deactivate_missing"/>
                            </group>
                        </group>
                        
                        <group invisible="not context.get('show_result', False)">
                            <field name="import_result" readonly="1" nolabel="1"/>
                        </group>
                        
                        <div class="alert alert-info" role="alert" invisible="context.get('show_result', False)">
                            <strong>Instructions:</strong><br/>
                            1. Upload the <code>documenti.csv</code> file from Alloggiati Web<br/>
                            2. The CSV should have columns: Code, Description<br/>
                            3. Use semicolon (;) as delimiter<br/>
                            4. Document types will be stored in OCA PMS compatible format<br/>
                            5. Choose your import options below
                        </div>
                    </sheet>
                    
                    <footer>
                        <button name="action_import_csv" 
                                string="Import CSV" 
                                type="object" 
                                class="btn-primary"
                                invisible="context.get('show_result', False)"/>
                        <button name="action_close" 
                                string="Close" 
                                type="object" 
                                class="btn-secondary"
                                invisible="not context.get('show_result', False)"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- PMS Document Type Import Wizard Action -->
        <record id="action_pms_document_type_import_wizard" model="ir.actions.act_window">
            <field name="name">Import Document Types</field>
            <field name="res_model">pms.document.type.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Import document types from CSV
                </p>
                <p>
                    Use this wizard to import document types from the 
                    documenti.csv file provided by Alloggiati Web.
                    The imported types will be OCA PMS compatible.
                </p>
            </field>
        </record>

    </data>
