            <field name="name">Registration Alert: Manager Access</field>
            <field name="model_id" ref="model_pms_guest_registration_alert"/>
            <field name="domain_force">[('property_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('pms.group_pms_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Alloggiati Table Rules -->
        <record id="alloggiati_table_rule_company" model="ir.rule">
            <field name="name">Alloggiati Table: Company Access</field>
            <field name="model_id" ref="model_alloggiati_table"/>
            <field name="domain_force">['|', ('property_id', '=', False), ('property_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('pms.group_pms_user')), (4, ref('pms.group_pms_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="alloggiati_table_rule_manager" model="ir.rule">
            <field name="name">Alloggiati Table: Manager Write Access</field>
            <field name="model_id" ref="model_alloggiati_table"/>
            <field name="domain_force">['|', ('property_id', '=', False), ('property_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('pms.group_pms_manager'))]"/>
            <field name="perm_read" eval="True"/>
